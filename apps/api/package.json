{
    "name": "@yesbheem/api",
    "version": "0.1.0",
    "private": true,
    "description": "YesBheem API — Fastify backend",
    "main": "dist/index.js",
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "build": "tsc --project tsconfig.json",
        "start": "node dist/index.js",
        "typecheck": "tsc --noEmit",
        "db:generate": "prisma generate",
        "db:migrate": "prisma migrate dev",
        "db:migrate:prod": "prisma migrate deploy",
        "db:studio": "prisma studio",
        "db:push": "prisma db push"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1007.0",
        "@aws-sdk/s3-request-presigner": "^3.1007.0",
        "@fastify/cors": "^9.0.1",
        "@fastify/helmet": "^11.1.1",
        "@fastify/multipart": "^8.3.1",
        "@fastify/rate-limit": "^9.1.0",
        "@fastify/sensible": "^5.5.0",
        "@google/genai": "^1.44.0",
        "@hapi/boom": "^10.0.1",
        "@itsukichan/baileys": "github:Itsukichann/Baileys",
        "@prisma/client": "^5.14.0",
        "@sentry/node": "^10.43.0",
        "@sentry/profiling-node": "^10.43.0",
        "@yesbheem/shared": "workspace:*",
        "baileys-antiban": "^1.0.0",
        "bcryptjs": "^3.0.3",
        "bullmq": "^5.8.1",
        "date-fns": "^4.1.0",
        "dotenv": "^16.4.5",
        "fastify": "^4.28.1",
        "ioredis": "^5.3.2",
        "jose": "^6.2.0",
        "pino": "^9.2.0",
        "pino-pretty": "^11.2.1",
        "qrcode-terminal": "^0.12.0",
        "zod": "^3.23.8",
        "prisma": "^5.14.0"
    },
    "devDependencies": {
        "@types/bcryptjs": "^3.0.0",
        "@types/hapi__boom": "^9.0.1",
        "@types/node": "^20.14.8",
        "@types/qrcode-terminal": "^0.12.2",
        "@whiskeysockets/baileys": "7.0.0-rc.9",
        "@yesbheem/config": "workspace:*",
        "tsx": "^4.15.7",
        "typescript": "^5.4.5"
    }
}