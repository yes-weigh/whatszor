+ALTER TABLE "agent_daily_metrics" ADD CONSTRAINT "agent_daily_metrics_agent_id_fkey" FOREIGN KEY ("agent_id") REFERENCES "users"("id") ON DELETE CASCADE ON UPDATE CASCADE;
