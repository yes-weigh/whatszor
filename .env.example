# ============================================================
# YesBheem – Environment Configuration
# Copy this file to .env and fill in your values.
# ============================================================

# --- Application ---
NODE_ENV=development
PORT=3001
API_URL=http://localhost:3001

# --- Database ---
DATABASE_URL=postgresql://postgres:password@localhost:5432/yesbheem_dev

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Authentication ---
JWT_SECRET=change_this_to_a_very_long_random_secret_string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# --- CORS ---
CORS_ORIGIN=http://localhost:3000

# --- Logging ---
LOG_LEVEL=info

# --- BullMQ ---
# Uses the same Redis instance. Override if needed.
# BULLMQ_REDIS_URL=redis://localhost:6379

# --- WhatsApp (Phase 5) ---
# WA_PHONE_NUMBER_ID=
# WA_ACCESS_TOKEN=

# --- AI (Phase 8) ---
# GEMINI_API_KEY=
# OPENAI_API_KEY=
