{
  "name": "yesbheem",
  "version": "0.1.0",
  "private": true,
  "description": "YesBheem – AI-native WhatsApp CRM SaaS Platform",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev:up": "docker compose -f docker-compose.dev.yml up -d",
    "dev:down": "docker compose -f docker-compose.dev.yml down",
    "dev:api": "pnpm --filter api dev",
    "dev:web": "pnpm --filter web dev",
    "dev": "pnpm run dev:up && concurrently -c \"blue,green\" -n \"api,web\" \"pnpm run dev:api\" \"pnpm run dev:web\"",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter api run db:generate",
    "db:migrate": "pnpm --filter api run db:migrate",
    "db:migrate:prod": "pnpm --filter api run db:migrate:prod",
    "db:studio": "pnpm --filter api run db:studio",
    "db:push": "pnpm --filter api run db:push",
    "clean": "pnpm -r exec rm -rf dist .next node_modules"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "typescript": "^5.4.5"
  },
  "pnpm": {
    "overrides": {
      "ioredis": "^5.3.2"
    },
    "patchedDependencies": {
      "baileys-antiban@1.0.0": "patches/baileys-antiban@1.0.0.patch"
    }
  }
}